maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=glibc
pkgver=2.44
pkgrel=1
subpackages="glibc-dev glibc-toolchain"
_gccver=16.2.0
_target=x86_64-zainium-linux-gnu
# glibc lives in its own directory in the userland, apart from musl's
# (/overlayer/syshub/x86_64-zainium-linux-musl): its loader, libraries, headers and tools.
# The glibc gcc uses the userland as its prefix, so this is also its tool directory.
_prefix=/overlayer/zexlib/union
_glibc=$_prefix/$_target
source="https://ftp.gnu.org/gnu/glibc/glibc-$pkgver.tar.xz
https://ftp.gnu.org/gnu/gcc/gcc-$_gccver/gcc-$_gccver.tar.gz
0001-zainium-glibc-paths.patch
0002-zainium-gcc-gnu-paths.patch"
sha256sums="37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667  glibc-$pkgver.tar.xz
071d00a097579e5ef7ce97fc4a9e58e73fd3503c0a013c765c970370a5a53b9b  gcc-$_gccver.tar.gz"
makedepends="bison flex texinfo gawk python3 perl patch"
needs_toolchain="linux-headers gcc-musl binutils"

# 0001-zainium-glibc-paths.patch: Zainium has no /etc, /bin, /usr or /var at the root, the
# system's files are under /overlayer/syshub (musl is set up the same way); glibc's own loader
# files (ld.so.cache, ld.so.conf, ld.so.preload) stay in its directory.
# 0002-zainium-gcc-gnu-paths.patch: the glibc gcc's programs ask for glibc's loader in glibc's
# directory, and x86_64 keeps its libraries in lib, not lib64 (as gcc-musl does).

# stage-1 gcc has no target libc (--without-headers) and gcc-full-libgcc only libgcc: both
# exist to compile glibc and are not published. The glibc gcc built last runs on Zainium
# (host: musl) and builds glibc programs (C and C++); its libstdc++/libgcc_s go to glibc's
# directory with glibc.
build() {
    # the musl loader and library path ci/build.sh exports are for musl packages: none of
    # glibc's files may carry them (glibc's own loader refuses to start with a RUNPATH)
    unset CFLAGS CPPFLAGS CXXFLAGS LDFLAGS

    cd "$SRCDIR"
    local bootstrap="$SRCDIR/_bootstrap"
    local sysroot="$bootstrap/sysroot"
    mkdir -p "$sysroot"

    (cd "glibc-$pkgver" && patch -p1 < "$SRCDIR/0001-zainium-glibc-paths.patch")
    (cd "gcc-$_gccver" && patch -p1 < "$SRCDIR/0002-zainium-gcc-gnu-paths.patch" && ./contrib/download_prerequisites)

    mkdir -p target-binutils
    for t in as ld ar ranlib nm objcopy objdump strip readelf; do
        ln -sf "$(command -v $t)" "target-binutils/$_target-$t"
    done

    export CC=/overlayer/syshub/bin/x86_64-zainium-linux-musl-gcc
    export CXX=/overlayer/syshub/bin/x86_64-zainium-linux-musl-g++
    export PATH="$SRCDIR/target-binutils:/overlayer/syshub/bin:$PATH"
    export LD_LIBRARY_PATH=/usr/lib:/lib

    mkdir -p gcc-stage1-build
    cd gcc-stage1-build
    ../gcc-$_gccver/configure \
        --target=$_target \
        --prefix="$bootstrap" \
        --without-headers \
        --enable-initfini-array \
        --disable-nls \
        --disable-shared \
        --disable-multilib \
        --disable-decimal-float \
        --disable-threads \
        --disable-libatomic \
        --disable-libgomp \
        --disable-libquadmath \
        --disable-libssp \
        --disable-libvtv \
        --disable-libstdcxx \
        --enable-languages=c,c++
    make -j"$(nproc)" all-gcc all-target-libgcc
    make install-gcc install-target-libgcc
    cd ..
    rm -rf gcc-stage1-build

    export PATH="$bootstrap/bin:$PATH"

    mkdir -p glibc-headers-build
    cd glibc-headers-build
    CC="$_target-gcc" \
    ../glibc-$pkgver/configure \
        --prefix=$_glibc \
        --host=$_target \
        --with-headers=/overlayer/syshub/include \
        --disable-werror
    make install-headers DESTDIR="$sysroot"
    cd ..

    # glibc's headers include the kernel's (<linux/...>): glibc's include directory carries
    # its own copy, so building against glibc never reaches into musl's headers
    for d in linux asm asm-generic mtd rdma scsi sound drm misc xen; do
        [ -d "/overlayer/syshub/include/$d" ] && \
            cp -a "/overlayer/syshub/include/$d" "$sysroot$_glibc/include/"
    done

    "$_target-gcc" -print-file-name=libc.so
    cd glibc-headers-build
    make csu/subdir_lib
    mkdir -p "$sysroot$_glibc/lib"
    cp csu/crt1.o csu/crti.o csu/crtn.o "$sysroot$_glibc/lib/"
    "$_target-gcc" -nostdlib -nostartfiles -shared -x c /dev/null \
        -o "$sysroot$_glibc/lib/libc.so"
    touch "$sysroot$_glibc/include/gnu/stubs.h"
    cd ..
    rm -rf glibc-headers-build

    mkdir -p gcc-full-libgcc-build
    cd gcc-full-libgcc-build
    ../gcc-$_gccver/configure \
        --target=$_target \
        --prefix="$bootstrap" \
        --with-native-system-header-dir=$_glibc/include \
        --disable-nls \
        --disable-shared \
        --disable-multilib \
        --disable-decimal-float \
        --disable-threads \
        --disable-libatomic \
        --disable-libgomp \
        --disable-libquadmath \
        --disable-libssp \
        --disable-libvtv \
        --disable-libstdcxx \
        --enable-languages=c \
        --with-sysroot="$sysroot"
    make -j"$(nproc)" all-gcc

    # target-libgcc's own autoconf-generated configure re-probes the C
    # preprocessor from scratch and its "$CC -E" detection misfires in
    # this nested cross-build (falls back to a nonexistent /lib/cpp) --
    # same class of cross-compile answer autoconf can't safely probe as
    # bash's ZEXBUILD ac_cv_* overrides. Force it directly to xgcc -E,
    # scoped to just this step so it doesn't leak into all-gcc's own
    # host-side sub-configures (those need the BUILD machine's cpp).
    ac_cv_prog_CPP="$bootstrap/bin/$_target-gcc -E" make -j"$(nproc)" all-target-libgcc
    make install-target-libgcc
    cd ..
    rm -rf gcc-full-libgcc-build

    mkdir -p glibc-build
    cd glibc-build
    # glibc's own config in its directory; the system's timezone data and zone
    printf '%s\n' "zonedir=/overlayer/syshub/share/zoneinfo" \
        "localtime-file=/overlayer/syshub/etc/localtime" > configparms
    CC="$_target-gcc" \
    ../glibc-$pkgver/configure \
        --prefix=$_glibc \
        --sysconfdir=$_glibc/etc \
        --localstatedir=/overlayer/syshub/var \
        --host=$_target \
        --with-headers="$sysroot$_glibc/include" \
        --disable-werror \
        --enable-kernel=6.1.0 \
        --disable-nscd \
        --disable-systemtap
    make -j"$(nproc)"
    make install DESTDIR="$sysroot"
    cd ..
    rm -rf glibc-build

    # glibc at its real path in this build container: the glibc gcc below is built and
    # tested against it, and its tools run from there
    mkdir -p "$_prefix"
    rm -rf "$_glibc"
    cp -a "$sysroot$_glibc" "$_prefix/"
    _glibc_files

    # the glibc gcc, run on Zainium: musl host, glibc target, the base binutils
    export PATH="$(echo "$PATH" | sed "s|$bootstrap/bin:||")"
    mkdir -p gcc-gnu-build
    cd gcc-gnu-build
    CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" \
    CFLAGS_FOR_TARGET="-O2 -pipe" CXXFLAGS_FOR_TARGET="-O2 -pipe" \
    ../gcc-$_gccver/configure \
        --build=x86_64-zainium-linux-musl \
        --host=x86_64-zainium-linux-musl \
        --target=$_target \
        --prefix=$_prefix \
        --with-sysroot=/ \
        --with-native-system-header-dir=$_glibc/include \
        --with-as=/overlayer/syshub/bin/as \
        --with-ld=/overlayer/syshub/bin/ld \
        --with-pkgversion="GCC 16 (Zainium OS 16, glibc)" \
        --with-gcc-major-version-only \
        --with-bugurl=https://zainiumdynamics.tech \
        --enable-languages=c,c++ \
        --enable-shared \
        --enable-threads=posix \
        --enable-tls \
        --enable-lto \
        --enable-default-pie \
        --enable-default-ssp \
        --enable-__cxa_atexit \
        --disable-bootstrap \
        --disable-multilib \
        --disable-nls \
        --disable-libcc1 \
        --disable-libsanitizer \
        --disable-libgomp \
        --disable-libitm \
        --disable-libquadmath \
        --disable-libssp \
        --disable-libvtv \
        --disable-libstdcxx-pch \
        --disable-werror
    make -j"$(nproc)"
    make install DESTDIR="$SRCDIR/gcc-gnu-install"
    cd ..
    rm -rf gcc-gnu-build
    _check
}

# Locales (Zainium's LANG is C.UTF-8), the gconv cache, and glibc's scripts pointed at the
# base's shell and perl and at glibc's loader (ldd's list names lib64).
_glibc_files() {
    local src="$SRCDIR/glibc-$pkgver/localedata"
    mkdir -p "$_glibc/lib/locale"
    for l in C.UTF-8:C en_US.UTF-8:en_US; do
        env -u LD_LIBRARY_PATH I18NPATH="$src" "$_glibc/bin/localedef" --no-archive \
            -i "${l#*:}" -f UTF-8 "${l%%:*}" || { echo "localedef ${l%%:*} failed" >&2; return 1; }
    done
    env -u LD_LIBRARY_PATH "$_glibc/sbin/iconvconfig"
    sed -i "s|^RTLDLIST=.*|RTLDLIST=\"$_glibc/lib/ld-linux-x86-64.so.2\"|" "$_glibc/bin/ldd"
    for f in "$_glibc"/bin/*; do
        head -c2 "$f" | grep -q '#!' || continue
        sed -i -e '1s|^#! */bin/|#!/overlayer/syshub/bin/|' -e '1s|^#! */usr/bin/|#!/overlayer/syshub/bin/|' "$f"
    done
}

# Every glibc file loads with glibc's loader and no library path, its programs ask for the
# loader in glibc's directory, and no FHS system path is left in libc.
_check() {
    local f bad=""
    for f in $(find "$_glibc" "$SRCDIR/gcc-gnu-install$_glibc/lib" -type f -name '*.so*') "$_glibc"/bin/* "$_glibc"/sbin/*; do
        head -c4 "$f" | grep -q ELF || continue
        readelf -d "$f" 2>/dev/null | grep -qE 'RPATH|RUNPATH' && bad="$bad $f(rpath)"
        interp="$(readelf -l "$f" 2>/dev/null | sed -n 's/.*interpreter: \([^]]*\).*/\1/p')"
        [ -z "$interp" ] || [ "$interp" = "$_glibc/lib/ld-linux-x86-64.so.2" ] || bad="$bad $f($interp)"
    done
    for p in /etc/passwd /etc/resolv.conf /etc/hosts /etc/nsswitch.conf; do
        strings "$_glibc/lib/libc.so.6" | grep -qx "$p" && bad="$bad libc.so.6($p)"
    done
    [ -z "$bad" ] || { echo "glibc check failed:$bad" >&2; return 1; }
    env -u LD_LIBRARY_PATH "$_glibc/bin/getconf" GNU_LIBC_VERSION
}

# glibc's loader, libraries, gconv modules, locales and tools, and gcc's libstdc++ and
# libgcc_s built against it: what glibc programs need to run.
package() {
    local d="$PAYLOAD_DIR/$_target" g="$SRCDIR/gcc-gnu-install$_glibc/lib" f
    mkdir -p "$d/lib"
    for f in "$_glibc"/lib/*.so* "$g"/libstdc++.so* "$g"/libgcc_s.so* "$g"/libatomic.so*; do
        [ -e "$f" ] || continue
        case "$f" in
            *-gdb.py) ;;
            *.so.*) cp -P "$f" "$d/lib/" ;;
            # unversioned: only real libraries (LD_PRELOAD helpers); links and linker scripts are -dev
            *) [ ! -L "$f" ] && head -c4 "$f" | grep -q ELF && cp "$f" "$d/lib/" ;;
        esac
    done
    for sub in gconv locale audit; do
        [ -d "$_glibc/lib/$sub" ] && cp -a "$_glibc/lib/$sub" "$d/lib/"
    done
    for sub in bin sbin libexec etc share; do
        [ -d "$_glibc/$sub" ] && cp -a "$_glibc/$sub" "$d/"
    done
    rm -rf "$d/share/info" "$d/share/man"
}

# Headers (glibc, the kernel's, libstdc++), static libraries, crt objects and the link-time
# names (libc.so, libm.so linker scripts and the unversioned .so links).
dev() {
    local d="$PAYLOAD_DIR/$_target" g="$SRCDIR/gcc-gnu-install$_glibc" f
    mkdir -p "$d/lib"
    cp -a "$_glibc/include" "$d/"
    cp -a "$g/include/." "$d/include/"
    # two header comments name /usr/include for the kernel headers glibc carries itself
    sed -i "s|/usr/include/linux|$_glibc/include/linux|" "$d/include/linux/netdevice.h" "$d/include/sys/mount.h"
    for f in "$_glibc"/lib/*.a "$_glibc"/lib/*.o "$_glibc"/lib/*.so "$g"/lib/*.a "$g"/lib/*.so; do
        [ -e "$f" ] || continue
        case "$f" in
            *.so) { [ -L "$f" ] || ! head -c4 "$f" | grep -q ELF; } && cp -P "$f" "$d/lib/" ;;
            *) cp -P "$f" "$d/lib/" ;;
        esac
    done
}

# The glibc gcc and g++: x86_64-zainium-linux-gnu-gcc builds a program for glibc (plain gcc
# stays musl's). Its own files are under names and directories of the gnu target only.
toolchain() {
    local g="$SRCDIR/gcc-gnu-install$_prefix"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/lib/gcc" "$PAYLOAD_DIR/libexec/gcc"
    cp -a "$g"/bin/$_target-* "$PAYLOAD_DIR/bin/"
    cp -a "$g/lib/gcc/$_target" "$PAYLOAD_DIR/lib/gcc/"
    cp -a "$g/libexec/gcc/$_target" "$PAYLOAD_DIR/libexec/gcc/"
    # nothing outside the gnu target's names, so no file of musl's gcc is shadowed
    local other
    other="$(cd "$g" && find . -type f ! -path "./bin/$_target-*" ! -path "./lib/gcc/$_target/*" \
        ! -path "./libexec/gcc/$_target/*" ! -path "./$_target/*" ! -path "./share/*")"
    [ -z "$other" ] || { echo "glibc gcc installed other files:" >&2; echo "$other" >&2; return 1; }
}
