maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=python
pkgver=3.14.6
pkgrel=0
subpackages="$pkgname-dev"
source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz"
sha256sums="143b1dddefaec3bd2e21e3b839b34a2b7fb9842272883c576420d605e9f30c63  Python-$pkgver.tar.xz"
makedepends="bzip2-dev expat-dev libffi-dev linux-headers mpdecimal-dev musl-libintl ncurses-dev openssl-dev readline-dev sqlite-dev xz-dev zlib-dev"

build() {
    cd "$SRCDIR/Python-$pkgver"
    rm -r Modules/expat
    patch -p1 < "$RECIPE_DIR/0001-musl-find_library-zainium-paths.patch"

    export CFLAGS_NODIST="${CFLAGS:-} -DTHREAD_STACK_SIZE=0x200000"
    export LDFLAGS_NODIST="${LDFLAGS:-} -Wl,-z,stack-size=8388608"
    export LD_LIBRARY_PATH="/usr/lib:/lib"
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --mandir=/overlayer/syshub/share/man \
        --infodir=/overlayer/syshub/share/info \
        --localstatedir=/overlayer/syshub/var \
        --enable-ipv6 \
        --enable-loadable-sqlite-extensions \
        --enable-shared \
        --with-computed-gotos \
        --with-system-expat \
        --with-system-libmpdec \
        --without-ensurepip
    make -j"$(nproc)"
}

package() {
    cd "$SRCDIR/Python-$pkgver"
    make -j1 DESTDIR="$PAYLOAD_DIR" install maninstall
    ln -sf python3 "$PAYLOAD_DIR/overlayer/syshub/bin/python"
    ln -sf python3-config "$PAYLOAD_DIR/overlayer/syshub/bin/python-config"

    rm -rf "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14/test" \
        "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14/idlelib" \
        "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14/turtledemo" \
        "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14/ensurepip/_bundled"

    sed -i \
        -e 's#PEM_HEADER = "-----BEGIN CERTIFICATE-----"#PEM_HEADER = "-" * 5 + "BEGIN CERTIFICATE" + "-" * 5#' \
        -e 's#PEM_FOOTER = "-----END CERTIFICATE-----"#PEM_FOOTER = "-" * 5 + "END CERTIFICATE" + "-" * 5#' \
        "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14/ssl.py"
    sed -i "s#passwd='geheim\$parole')#passwd=PASSWORD)#" \
        "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14/urllib/request.py"

    find "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14" -type d -name '__pycache__' -exec rm -rf {} +

    find "$PAYLOAD_DIR/overlayer/syshub/lib/python3.14" -type f \
        \( -name '*.py' -o -name '*.json' -o -name 'Makefile' \) \
        -exec grep -Il '/usr' {} \; | while IFS= read -r f; do
        sed -i 's#/usr#/overlayer/syshub#g' "$f"
    done

    mkdir -p "$STAGING_ROOT/_python-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_python-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_python-dev/pkgconfig"
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_python-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_python-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
