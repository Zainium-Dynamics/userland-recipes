maintainer="Ali Zain <heyalizain@gmail.com>"
pkgname=git
pkgver=2.54.0
pkgrel=3
source="https://mirrors.edge.kernel.org/pub/software/scm/git/git-$pkgver.tar.xz"
# sha256 independently re-verified 2026-08-11 against kernel.org's own
# published sha256sums.asc for this release.
sha256sums="f689162364c10de79ef89aa8dbf48731eb057e34edbbd20aca510ce0154681a3  git-$pkgver.tar.xz"

# Git's own release tarball ships configure.ac but no pre-generated
# ./configure (that only exists in the git.org "full" tarball, not this
# kernel.org one) — so, same as the proven local build at
# /zex-native/git-2.54.0/build-zainium-musl.sh, this drives the build
# straight through git's Makefile via a config.mak instead of autoconf.
# NO_GETTEXT/NO_PERL/NO_PYTHON/NO_TCLTK match that reference build
# exactly. NO_OPENSSL is also kept (git's own SHA1/HMAC code falls back
# to its bundled implementation) — HTTPS clone/push still works through
# libcurl, which brings its own TLS backend independent of this flag.
#
# Interpreter/rpath/SHELL_PATH are baked straight into the binary here
# (BASIC_LDFLAGS/EXTRA_CPPFLAGS below), not left for `substrate pack`'s
# elfpatch step alone — same runtime paths the reference build's own top
# comment documents: interpreter, rpath and SHELL_PATH all live under
# /overlayer/syshub/. elfpatch still runs afterward and will find these
# already correct (a no-op confirmation, not a fix).
build() {
    # Alpine's bash package lands wherever that image's /bin symlink
    # policy puts it — detect it instead of hardcoding /bin/bash.
    HOST_BASH="$(command -v bash)"
    cat > config.mak <<CFG
prefix = /overlayer/syshub
sysconfdir = /overlayer/syshub/etc
NO_GETTEXT = YesPlease
NO_PERL = YesPlease
NO_PYTHON = YesPlease
NO_TCLTK = YesPlease
NO_OPENSSL = YesPlease

# musl's regex implementation has no REG_STARTEND (a glibc extension) —
# tell Git to use its own bundled regex instead of the system one.
NO_REGEX = NeedsStartEnd

# Prevent Git's Makefile from auto-converting -L host paths into its own
# conflicting -Wl,-rpath entries.
NO_R_TO_GCC_LINKER = YesPlease

# Strip debug symbols at install time — one unstripped binary alone
# (git itself) was ~19MB vs ~4MB stripped, and git installs ~15
# genuinely separate executables (git-remote-http, git-daemon,
# git-credential-*, etc, not just hardlinked builtin dispatch names),
# so this is most of the difference between an accidentally-glibc,
# unstripped .zex and a real, lean musl one.
INSTALL_STRIP = -s
CFLAGS = -O2

# Build-time shell (make recipes run on the CI host) stays the real host
# shell. Runtime SHELL_PATH (compiled into the binary, used for hooks /
# `git rebase -i` / etc. on an actual Zainium boot) is overridden right
# after via EXTRA_CPPFLAGS — last -D wins over this SHELL_PATH.
SHELL_PATH = $HOST_BASH
TEST_SHELL_PATH = $HOST_BASH
EXTRA_CPPFLAGS += -DSHELL_PATH='"/overlayer/syshub/bin/bash"'

BASIC_LDFLAGS += -Wl,-dynamic-linker,/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1
BASIC_LDFLAGS += -Wl,-rpath,/overlayer/syshub/lib
BASIC_LDFLAGS += -Wl,-rpath,/overlayer/syshub/x86_64-zainium-linux-musl/lib
CFG
    make
}

package() {
    make DESTDIR="$PAYLOAD_DIR" install
}
