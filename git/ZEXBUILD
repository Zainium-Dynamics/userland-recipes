maintainer="Ali Zain <heyalizain@gmail.com>"
pkgname=git
pkgver=2.56.0
pkgrel=0
source="https://mirrors.edge.kernel.org/pub/software/scm/git/git-$pkgver.tar.xz"
sha256sums="26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3  git-$pkgver.tar.xz"

build() {
    HOST_BASH="$(command -v bash)"

    sed -i 's#"/usr/local/bin:/usr/bin:/bin"#"/overlayer/syshub/bin"#' git-compat-util.h
    sed -i 's#/etc/mailname#/overlayer/syshub/etc/mailname#g' ident.c
    cat > config.mak <<CFG
prefix = /overlayer/syshub
sysconfdir = /overlayer/syshub/etc
NO_GETTEXT = YesPlease
NO_PERL = YesPlease
NO_PYTHON = YesPlease
NO_TCLTK = YesPlease
NO_OPENSSL = YesPlease
NO_RUST = YesPlease

NO_REGEX = NeedsStartEnd

HAVE_ALLOCA_H = YesPlease
HAVE_PATHS_H = YesPlease
HAVE_DEV_TTY = YesPlease
HAVE_CLOCK_GETTIME = YesPlease
HAVE_CLOCK_MONOTONIC = YesPlease
HAVE_SYNC_FILE_RANGE = YesPlease
HAVE_GETDELIM = YesPlease
HAVE_SYSINFO = YesPlease
CSPRNG_METHOD = getrandom
PROCFS_EXECUTABLE_PATH = /proc/self/exe
NO_STRLCPY =
NO_ICONV =
NEEDS_LIBICONV =

NO_R_TO_GCC_LINKER = YesPlease

INSTALL_STRIP = -s
CFLAGS = -O2 -pipe -fPIC

SHELL_PATH = $HOST_BASH
TEST_SHELL_PATH = $HOST_BASH
EXTRA_CPPFLAGS += -DSHELL_PATH='"/overlayer/syshub/bin/bash"'

BASIC_LDFLAGS += -Wl,-dynamic-linker,/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1
BASIC_LDFLAGS += -Wl,-rpath,/overlayer/syshub/lib
BASIC_LDFLAGS += -Wl,-rpath,/overlayer/syshub/x86_64-zainium-linux-musl/lib
CFG
    make
}

package() {
    make DESTDIR="$PAYLOAD_DIR" install
    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}
