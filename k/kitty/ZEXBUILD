maintainer="Ali Zain <heyalizain@gmail.com>"
pkgname=kitty
pkgver=0.50.0
pkgrel=0
source="https://github.com/kovidgoyal/kitty/releases/download/v$pkgver/kitty-$pkgver.tar.xz
0001-zainium-paths.patch"
sha256sums="01f20d0b253af0a7e041394a501adc83483f2eee01faf607a933c028343ab71a  kitty-$pkgver.tar.xz"
# Zainium's own libraries and headers where we have them; only build tools and the
# libraries the base lacks (lcms2, xxhash, librsync, simde, X11 parts) come from Alpine
needs_toolchain="gettext python python-dev cairo cairo-dev harfbuzz harfbuzz-dev fontconfig fontconfig-dev freetype freetype-dev libxkbcommon libxkbcommon-dev wayland wayland-dev wayland-protocols dbus dbus-dev libpng libpng-dev zlib zlib-dev openssl openssl-dev mesa mesa-dev ncurses ncurses-dev pkgconf"
makedepends="go libx11-dev libxcursor-dev libxrandr-dev libxinerama-dev libxi-dev lcms2-dev xxhash-dev librsync-dev simde font-nerd-fonts-symbols"

# The kitty terminal. 0001-zainium-paths.patch moves the paths kitty and its
# kitten helper read at run time to the Zainium layout: the system config in
# /overlayer/syshub/etc/xdg/kitty, the default XDG data dirs, terminfo, /etc/passwd,
# /etc/machine-id, the fallback shell and login. kitten is a static Go program, so
# sys_resolver can not redirect its paths; the patch has to.
build() {
    patch -p1 < "$SRCDIR/0001-zainium-paths.patch"
    # build against Zainium's headers and libraries, with Zainium's python
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export CPPFLAGS="-I/overlayer/syshub/include ${CPPFLAGS:-}"
    export LDFLAGS="-L/overlayer/syshub/lib ${LDFLAGS:-}"
    /overlayer/syshub/bin/python3 setup.py linux-package \
        --prefix "$SRCDIR/out/overlayer/syshub" \
        --update-check-interval=0 \
        --verbose
}

package() {
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$SRCDIR/out/overlayer" "$PAYLOAD_DIR/"
}
