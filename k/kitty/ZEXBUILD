maintainer="Ali Zain <heyalizain@gmail.com>"
pkgname=kitty
pkgver=0.50.0
pkgrel=0
source="https://github.com/kovidgoyal/kitty/releases/download/v$pkgver/kitty-$pkgver.tar.xz
0001-zainium-paths.patch
0002-wayland-only.patch
https://github.com/shader-slang/slang/releases/download/v2026.14.1/slang-2026.14.1-linux-x86_64.tar.gz"
sha256sums="01f20d0b253af0a7e041394a501adc83483f2eee01faf607a933c028343ab71a  kitty-$pkgver.tar.xz
21f2d7847385a770e569fb61b1507a7794d742d97850bce0432bff0032ca005f  slang-2026.14.1-linux-x86_64.tar.gz"
# Zainium's own libraries and headers where we have them; only build tools and the
# libraries the base lacks (lcms2, xxhash, simde) come from Alpine
needs_toolchain="gcc-musl binutils linux-headers libglvnd libglvnd-dev gettext python python-dev pixman pixman-dev glib glib-dev pcre2 pcre2-dev libffi libffi-dev expat expat-dev bzip2 bzip2-dev brotli brotli-dev libdrm libdrm-dev util-linux cairo cairo-dev harfbuzz harfbuzz-dev fontconfig fontconfig-dev freetype freetype-dev libxkbcommon libxkbcommon-dev wayland wayland-dev wayland-protocols dbus dbus-dev systemd systemd-dev libpng libpng-dev zlib zlib-dev openssl openssl-dev mesa mesa-dev ncurses ncurses-dev pkgconf"
makedepends="go ncurses gcompat libstdc++ lcms2-dev lcms2-static xxhash-dev simde-dev font-nerd-fonts-symbols"

# The kitty terminal. 0001-zainium-paths.patch moves every path kitty and its kitten
# helper use to the Zainium layout, shebangs and man pages too (made with replant):
# kitten is a static Go program, so sys_resolver can not redirect its paths.
# The patch also links desktop OpenGL from libglvnd's libOpenGL (opengl.pc) and
# loads libOpenGL.so.0 first, because Zainium is Wayland only and has no libGL.
build() {
    patch -p1 < "$SRCDIR/0001-zainium-paths.patch"
    # Zainium has no X11, so only the Wayland backend is built
    patch -p1 < "$SRCDIR/0002-wayland-only.patch"
    # build with Zainium's own compiler, against Zainium's headers and libraries,
    # with Zainium's python
    export CC="/overlayer/syshub/bin/x86_64-zainium-linux-musl-gcc"
    # kitty turns its .slang shaders into GLSL with slangc at build time; the version kitty's
    # own builds use, from shader-slang's release (glibc, run through gcompat), not packaged
    export SLANGC="$SRCDIR/bin/slangc"
    # lcms2 and xxhash are not in the base, so they are linked in statically.
    # Their headers and simde's go in a private dir, since Zainium's gcc does not look in /usr/include
    D="$SRCDIR/static-deps"
    mkdir -p "$D/include" "$D/pkgconfig"
    cp /usr/include/xxhash.h /usr/include/xxh3.h /usr/include/lcms2*.h "$D/include/"
    cp -r /usr/include/simde "$D/include/"
    printf 'Name: simde\nDescription: simde\nVersion: 0.8\nCflags: -I%s/include\n' "$D" > "$D/pkgconfig/simde.pc"
    # Alpine's libxxhash.a is LTO bytecode from an older gcc, so build it here from the header
    printf '#define XXH_IMPLEMENTATION\n#define XXH_STATIC_LINKING_ONLY\n#include "xxhash.h"\n' > "$D/xxhash.c"
    "$CC" -O3 -fPIC -I"$D/include" -c "$D/xxhash.c" -o "$D/xxhash.o"
    ar rcs "$D/libxxhash.a" "$D/xxhash.o"
    printf 'Name: libxxhash\nDescription: xxhash\nVersion: 0.8\nCflags: -I%s/include\nLibs: %s/libxxhash.a\n' "$D" "$D" > "$D/pkgconfig/libxxhash.pc"
    printf 'Name: lcms2\nDescription: lcms2\nVersion: 2.16\nCflags: -I%s/include\nLibs: /usr/lib/liblcms2.a -lm -lpthread\n' "$D" > "$D/pkgconfig/lcms2.pc"
    export PKG_CONFIG_PATH="$D/pkgconfig:/overlayer/syshub/lib/pkgconfig:/overlayer/syshub/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export CPPFLAGS="-I/overlayer/syshub/include ${CPPFLAGS:-}"
    export LDFLAGS="-L/overlayer/syshub/lib ${LDFLAGS:-}"
    /overlayer/syshub/bin/python3 setup.py linux-package \
        --prefix "$SRCDIR/out/overlayer/syshub" \
        --update-check-interval=0 \
        --verbose
}

package() {
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$SRCDIR/out/overlayer" "$PAYLOAD_DIR/"
}
