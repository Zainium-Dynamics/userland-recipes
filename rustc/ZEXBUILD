maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=rustc
pkgver=1.99.1
pkgrel=0
source="https://static.rust-lang.org/dist/rustc-$pkgver-src.tar.gz
0001-zainium-targets.patch"
sha256sums="db56bbc64db491ceda6b78a2811a6d121c639338906fd944f720289cbd02245c  rustc-$pkgver-src.tar.gz"
makedepends="build-base python3 ninja git perl make pkgconf"
needs_toolchain="musl gcc-musl binutils cmake curl curl-dev pkgconf linux-headers llvm llvm-dev xz xz-dev zlib zlib-dev libffi libffi-dev zstd zstd-dev libxml2 libxml2-dev ncurses ncurses-dev"

build() {
    cd "$SRCDIR/rustc-$pkgver-src"
    patch -p1 < "$SRCDIR/0001-zainium-targets.patch"

    local sysroot=/overlayer/syshub

    for sub in "src/doc/book:https://github.com/rust-lang/book.git" "src/doc/reference:https://github.com/rust-lang/reference.git" "src/tools/rustc-perf:https://github.com/rust-lang/rustc-perf.git"; do
        dest="${sub%%:*}"
        url="${sub#*:}"
        if [ -z "$(ls -A "$dest" 2>/dev/null)" ]; then
            rm -rf "$dest"
            git clone -q --depth 1 "$url" "$dest"
        fi
    done

    for pair in "libstdc++.so.6:libstdc++.so.6.0.*" "libstdc++.so:libstdc++.so.6.0.*" "libatomic.so.1:libatomic.so.1.*"; do
        link="${pair%%:*}"
        [ -e "$sysroot/lib/$link" ] && continue
        real="$(ls "$sysroot"/lib/${pair#*:} 2>/dev/null | grep -v -e '-gdb.py' | head -1)"
        [ -n "$real" ] && ln -s "$(basename "$real")" "$sysroot/lib/$link"
    done
    local triple=x86_64-zainium-linux-musl
    local musl_root="$sysroot/$triple"
    local gccver
    gccver="$(ls "$sysroot/lib/gcc/$triple" | head -1)"
    local gcc_prefix="$sysroot/lib/gcc/$triple/$gccver/"
    local cxx_inc="-I$sysroot/include/c++/$gccver -I$sysroot/include/c++/$gccver/$triple"

    cat > bootstrap.toml <<EOF
change-id = 154508
profile = "dist"

[llvm]
download-ci-llvm = false
link-shared = true

[build]
host = ["$triple"]
target = ["$triple"]
docs = false
compiler-docs = false
submodules = false
locked-deps = true
vendor = false
extended = true
tools = ["rustdoc", "clippy", "rustfmt", "rust-analyzer", "rust-analyzer-proc-macro-srv", "src"]
sanitizers = false
profiler = false
build-stage = 2
verbose = 1
description = "Zainium zexlib $pkgver"
optimized-compiler-builtins = false
cargo-native-static = true

[install]
prefix = "/overlayer/zexlib/union"
sysconfdir = "etc"

[rust]
channel = "stable"
download-rustc = false
optimize = true
debug = false
debug-assertions = false
debuginfo-level = 0
backtrace = true
incremental = false
codegen-units-std = 1
lto = "off"
jemalloc = false
rpath = true
dist-src = false
remap-debuginfo = true
lld = false
llvm-tools = true
deny-warnings = false

[target.x86_64-unknown-linux-musl]
cc = "/usr/bin/gcc"
cxx = "/usr/bin/g++"
ar = "/usr/bin/ar"
ranlib = "/usr/bin/ranlib"
linker = "/usr/bin/gcc"
llvm-config = "$sysroot/bin/llvm-config"
crt-static = false
rustflags = ["-Clink-arg=-L$sysroot/lib", "-Clink-arg=-Wl,-rpath=$sysroot/lib"]

[target.$triple]
cc = "$sysroot/bin/$triple-gcc"
cxx = "$sysroot/bin/$triple-g++"
ar = "$sysroot/bin/$triple-ar"
ranlib = "$sysroot/bin/$triple-ranlib"
linker = "$sysroot/bin/$triple-gcc"
musl-root = "$musl_root"
musl-libdir = "$musl_root/lib"
crt-static = false
llvm-libunwind = "no"
sanitizers = false
profiler = false
llvm-config = "$sysroot/bin/llvm-config"
rustflags = ["-Ctarget-feature=-crt-static", "-Clink-arg=-B$gcc_prefix", "-Clink-arg=-lzstd", "-Clink-arg=-lz"]
EOF

    export PATH="$PATH:$sysroot/bin"
    export BOOTSTRAP_SKIP_TARGET_SANITY=1
    export PKG_CONFIG_ALLOW_CROSS=1
    export CFLAGS_x86_64_zainium_linux_musl="-B$gcc_prefix"
    export CXXFLAGS_x86_64_zainium_linux_musl="-B$gcc_prefix $cxx_inc"
    export CC_x86_64_zainium_linux_musl="$sysroot/bin/$triple-gcc"
    export CXX_x86_64_zainium_linux_musl="$sysroot/bin/$triple-g++"
    export AR_x86_64_zainium_linux_musl="$sysroot/bin/$triple-ar"

    python3 ./x.py build --stage 2 -j"$(nproc)"
    DESTDIR="$(pwd)/_zexbuild-install" python3 ./x.py install -j"$(nproc)"
}

package() {
    local inst="$SRCDIR/rustc-$pkgver-src/_zexbuild-install/overlayer/zexlib/union"
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR/"
    rm -f "$PAYLOAD_DIR/lib/rustlib/install.log" "$PAYLOAD_DIR/lib/rustlib/uninstall.sh" "$PAYLOAD_DIR/lib/rustlib/components" "$PAYLOAD_DIR/lib/rustlib/rust-installer-version" "$PAYLOAD_DIR"/lib/rustlib/manifest-*

    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/zexlib/union#g' -e 's#/usr/#/overlayer/zexlib/union/#g' "$f"
    done
}
