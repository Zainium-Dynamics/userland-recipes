maintainer="alizainx <heyalizain@gmail.com>"
pkgname=xorgproto
pkgver=2024.1
pkgrel=0
source="https://xorg.freedesktop.org/archive/individual/proto/xorgproto-$pkgver.tar.xz"
sha256sums="372225fd40815b8423547f5d890c5debc72e88b91088fbfb13158c20495ccb59  xorgproto-$pkgver.tar.xz"
makedepends="meson samurai"

# X11 protocol headers. Build-time only: no runtime library, so it lives in the userland.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Dlegacy=true
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/share"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    [ -d "$inst/lib/pkgconfig" ] && cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
    [ -d "$inst/share/pkgconfig" ] && mkdir -p "$PAYLOAD_DIR/share/pkgconfig" && cp -a "$inst"/share/pkgconfig/. "$PAYLOAD_DIR/share/pkgconfig/"
    # no docs with /usr paths, and rewrite /usr comments left in the headers
    rm -rf "$PAYLOAD_DIR/share/doc" "$PAYLOAD_DIR/share/man"
    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}
