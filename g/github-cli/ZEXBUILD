maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=github-cli
pkgver=2.103.3
pkgrel=0
source="https://github.com/cli/cli/archive/refs/tags/v$pkgver.tar.gz
0001-zainium-paths.patch"
sha256sums="bb148138a3a2fe023e57c78042fe3b42fc09171c0e8fff4cf983b227b7a2eade  v$pkgver.tar.gz"
# Zainium's own Go: its standard library already reads resolv.conf, hosts and the
# CA certificates from /overlayer/syshub/etc, so gh finds DNS and TLS on its own
needs_toolchain="go"

# The GitHub CLI, gh. Built as a static Go program: no loader or preload is used,
# so the paths have to be right in the binary. 0001-zainium-paths.patch is made
# by replant and only moves the zsh completion path in the help text.
build() {
    cd "$SRCDIR/cli-$pkgver"
    patch -p1 < "$SRCDIR/0001-zainium-paths.patch"
    export GOROOT=/overlayer/syshub/lib/go
    export PATH="$GOROOT/bin:$PATH"
    export GOTOOLCHAIN=local CGO_ENABLED=0 GOFLAGS=-trimpath
    export GOPATH="$SRCDIR/gopath" GOCACHE="$SRCDIR/gocache"
    # the resolver path proves the build used Zainium's Go, not Alpine's
    grep -q '/overlayer/syshub/etc/resolv.conf' "$GOROOT/src/net/dnsclient_unix.go"
    go build -o bin/gh -ldflags "-s -w \
        -X github.com/cli/cli/v2/internal/build.Version=$pkgver \
        -X github.com/cli/cli/v2/internal/build.Date=$(date -u +%Y-%m-%d)" ./cmd/gh
    mkdir -p completions
    bin/gh completion -s bash > completions/gh.bash
    bin/gh completion -s zsh > completions/_gh
    bin/gh completion -s fish > completions/gh.fish
}

package() {
    cd "$SRCDIR/cli-$pkgver"
    install -Dm755 bin/gh "$PAYLOAD_DIR/bin/gh"
    install -Dm644 completions/gh.bash "$PAYLOAD_DIR/share/bash-completion/completions/gh"
    install -Dm644 completions/_gh "$PAYLOAD_DIR/share/zsh/site-functions/_gh"
    install -Dm644 completions/gh.fish "$PAYLOAD_DIR/share/fish/vendor_completions.d/gh.fish"
    install -Dm644 LICENSE "$PAYLOAD_DIR/share/licenses/github-cli/LICENSE"
}
