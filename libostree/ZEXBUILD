maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libostree
pkgver=2026.4
pkgrel=1
subpackages="libostree-dev"
source="https://github.com/ostreedev/ostree/releases/download/v$pkgver/libostree-$pkgver.tar.xz"
sha256sums="b26c9016eb03bb4ee52cc00c642d56e00fc79ae7faac6bf4aa317d7451339ef7  libostree-$pkgver.tar.xz"
makedepends="glib-dev bison curl-dev e2fsprogs-dev fuse3-dev gpgme-dev gtk-doc libarchive-dev libsoup3-dev libxslt linux-headers xz-dev pkgconf util-linux-dev"

needs_toolchain="openssl openssl-dev"

build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export CPPFLAGS="-I/overlayer/syshub/include ${CPPFLAGS:-}"
    export LDFLAGS="-L/overlayer/syshub/lib ${LDFLAGS:-}"
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --disable-gtk-doc \
        --disable-man \
        --disable-introspection \
        --with-dracut=no \
        --with-systemd=no \
        --with-curl \
        --with-soup3 \
        --with-libarchive \
        --with-crypto=openssl

    export LD_LIBRARY_PATH="/overlayer/syshub/lib"
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share" "$PAYLOAD_DIR/etc"
    find "$inst/lib" -maxdepth 1 -name 'libostree*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/bin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst/share/." "$PAYLOAD_DIR/share/" 2>/dev/null || true
    cp -a "$inst/etc/." "$PAYLOAD_DIR/etc/" 2>/dev/null || true
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
