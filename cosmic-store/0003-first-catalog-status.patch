 impl App {
+    /// Explore and category pages wait for app catalogs: say which, or that the download failed
+    fn catalog_indicator(&self) -> Element<'_, Message> {
+        use std::sync::atomic::Ordering;
+        if crate::backend::CATALOG_DOWNLOADS.load(Ordering::SeqCst) > 0 {
+            self.loading_indicator(&fl!("downloading-catalog"))
+        } else if crate::backend::CATALOG_FAILED.load(Ordering::SeqCst) {
+            widget::text(fl!("catalog-failed"))
+                .apply(widget::container)
+                .center(Length::Fill)
+                .into()
+        } else {
+            self.loading_indicator(&fl!("loading"))
+        }
+    }
