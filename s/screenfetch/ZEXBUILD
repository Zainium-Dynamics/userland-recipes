build() {
    cd screenfetch-*/
    SCREENFETCH_DISTRO=zainium \
    SCREENFETCH_LOGO=assets/logos/zainium_logo.svg \
    SCREENFETCH_SHARE_DIR=/overlayer/syshub/share \
    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    install -Dm755 target/x86_64-unknown-linux-musl/release/screenfetch "$PAYLOAD_DIR/bin/screenfetch"
}
