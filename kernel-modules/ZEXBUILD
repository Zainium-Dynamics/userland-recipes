maintainer="Ali Zain <heyalizain@gmail.com>"
pkgname=kernel-modules
pkgver=7.1
pkgrel=7
source="https://gitlab.com/Xenomai/xenomai4/linux-evl/-/archive/v7.1-evl-rebase/linux-evl-v7.1-evl-rebase.tar.gz"
sha256sums=""

# ci/build.sh only calls build()/package() — prepare() was never invoked.
build() {
    cd "$SRCDIR/linux-evl-v7.1-evl-rebase"

    patch -p1 < "$RECIPE_DIR/0001-oxidized-zainium-paths.patch"
    cp "$RECIPE_DIR/evl-7.1.defconfig" .config
    make ARCH=x86_64 olddefconfig
    make ARCH=x86_64 KERNELRELEASE=linux-evl-7.1 vmlinux -j2
    make ARCH=x86_64 KERNELRELEASE=linux-evl-7.1 modules -j2
}

package() {
    cd "$SRCDIR/linux-evl-v7.1-evl-rebase"

    make ARCH=x86_64 KERNELRELEASE=linux-evl-7.1 INSTALL_MOD_PATH="$PAYLOAD_DIR" \
        INSTALL_MOD_STRIP=1 DEPMOD=true modules_install
    mkdir -p "$PAYLOAD_DIR/drivers/modules"
    mv "$PAYLOAD_DIR/lib/modules/linux-evl-7.1" "$PAYLOAD_DIR/drivers/modules/linux-evl-7.1"
    rm -rf "$PAYLOAD_DIR/lib"
}
