pkgname=hello
pkgver=2.12.1
pkgrel=0
source="https://ftp.gnu.org/gnu/hello/hello-$pkgver.tar.gz"
sha256sums="8d99142afd92576f30b0cd7cb42a8dc6809998bc5d607d88761f512e26c7db20  hello-$pkgver.tar.gz"

build() {
    ./configure \
        --host="$CHOST" \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --mandir=/overlayer/syshub/share/man \
        --infodir=/overlayer/syshub/share/info \
        --localstatedir=/overlayer/syshub/var
    make
}

package() {
    make DESTDIR="$PAYLOAD_DIR" install
}
