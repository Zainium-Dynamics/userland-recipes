maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libgpg-error
pkgver=1.61
pkgrel=0
subpackages="libgpg-error-dev"
source="https://gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-$pkgver.tar.bz2"
sha256sums="7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93  libgpg-error-$pkgver.tar.bz2"
makedepends="build-base"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --disable-static \
        --disable-nls \
        --disable-doc \
        --disable-tests \
        --disable-languages
    make -j"$(nproc)"
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/lib"
    cp -a "$inst"/bin/gpg-error "$PAYLOAD_DIR/bin/"
    cp -P "$inst"/lib/libgpg-error.so.* "$PAYLOAD_DIR/lib/"
    if [ -d "$inst/share/libgpg-error" ]; then
        mkdir -p "$PAYLOAD_DIR/share"
        cp -a "$inst"/share/libgpg-error "$PAYLOAD_DIR/share/"
    fi
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -P "$inst"/lib/libgpg-error.so "$PAYLOAD_DIR/lib/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
    if [ -d "$inst/share/aclocal" ]; then
        mkdir -p "$PAYLOAD_DIR/share"
        cp -a "$inst"/share/aclocal "$PAYLOAD_DIR/share/"
    fi
    if [ -e "$inst/bin/gpgrt-config" ]; then
        mkdir -p "$PAYLOAD_DIR/bin"
        cp -a "$inst"/bin/gpgrt-config "$PAYLOAD_DIR/bin/"
    fi
    # gpgrt-config and the m4 macros only mention /usr in comments and system-path filters
    grep -rIl '/usr' "$PAYLOAD_DIR" | xargs -r sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g'
}
